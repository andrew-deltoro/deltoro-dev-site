---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
import { site, services } from '../../data/site';

export const getStaticPaths = (async () => {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, next: projects[(i + 1) % projects.length] },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { Content } = await render(project);
const data = project.data;
const related = services.find((s) => s.id === data.service);
const sorted = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const position = sorted.findIndex((p) => p.id === project.id) + 1;

const statusClass =
  data.status === 'Live' ? 'status--live' : data.status === 'In development' ? 'status--dev' : data.status === 'Archived' ? 'status--archived' : '';

const image = `/og/${project.id}.png`;
const coverImage = `${data.cover}-1440.webp`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: data.title,
    headline: data.kicker,
    description: data.summary,
    dateCreated: data.year,
    url: `${site.url}/work/${project.id}/`,
    image: new URL(coverImage, site.url).href,
    creator: {
      '@type': 'Person',
      name: site.name,
      url: site.url,
      sameAs: [site.linkedin, site.github],
    },
    keywords: data.stack.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Work', item: `${site.url}/work/` },
      { '@type': 'ListItem', position: 3, name: data.title, item: `${site.url}/work/${project.id}/` },
    ],
  },
];
---

<BaseLayout
  title={`${data.title} — ${data.kicker} | ${site.name}`}
  description={data.summary}
  image={image}
  type="article"
  jsonLd={jsonLd}
>
  <article>
    <header class="project-hero">
      <div class="wrap">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span aria-hidden="true">/</span>
          <a href="/work">Work</a><span aria-hidden="true">/</span>
          <span aria-current="page">{data.title}</span>
        </nav>

        <div class="project-title-row">
          <div>
            <p class="kicker">{data.category} · {data.year} · Project {String(position).padStart(2, '0')}</p>
            <h1>{data.title}</h1>
            <p class="summary">{data.summary}</p>
            <div class="project-actions">
              {data.liveUrl && (
                <a class="btn btn--accent" href={data.liveUrl} target="_blank" rel="noopener">
                  Open the live demo <span class="arrow" aria-hidden="true">↗</span>
                </a>
              )}
              {data.repoUrl && (
                <a class="btn btn--ghost" href={data.repoUrl} target="_blank" rel="noopener">
                  View the code <span class="arrow" aria-hidden="true">↗</span>
                </a>
              )}
              {related && <a class="btn btn--ghost" href={`/services#${related.id}`}>Related service</a>}
            </div>
          </div>

          <dl class="facts">
            <div><dt>Status</dt><dd><span class={`status ${statusClass}`}>{data.status}</span></dd></div>
            <div><dt>Role</dt><dd>{data.role}</dd></div>
            <div><dt>Timeline</dt><dd>{data.timeline}</dd></div>
            {data.client && <div><dt>Context</dt><dd>{data.client}</dd></div>}
            <div><dt>Stack</dt><dd>{data.stack.join(', ')}</dd></div>
          </dl>
        </div>

        <figure class="cover-wide">
          <img
            src={coverImage}
            srcset={`${data.cover}-720.webp 720w, ${data.cover}-1440.webp 1440w`}
            sizes="(max-width: 1180px) 100vw, 1140px"
            width="1440"
            height="900"
            alt={data.coverAlt}
            fetchpriority="high"
          />
          <figcaption>{data.title} — {data.kicker}</figcaption>
        </figure>
      </div>
    </header>

    <div class="wrap">
      <div class="project-body">
        <div>
          <div class="prose">
            <Content />
          </div>

          {data.gallery.length > 0 && (
            <div class="gallery">
              {data.gallery.map((img) => (
                <figure>
                  <img
                    src={img.src}
                    width="1440"
                    height="900"
                    alt={img.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  {img.caption && <figcaption>{img.caption}</figcaption>}
                </figure>
              ))}
            </div>
          )}

          {data.disclaimer && <p class="disclaimer">{data.disclaimer}</p>}
        </div>

        <aside class="aside">
          <h2>At a glance</h2>
          <ul>
            <li><b>Category</b><br />{data.category}</li>
            <li><b>Year</b><br />{data.year}</li>
            <li><b>Status</b><br />{data.status}</li>
            <li><b>Built with</b><br />{data.stack.join(', ')}</li>
          </ul>

          {related && (
            <div style="margin-top:1.6rem">
              <h2>Need this?</h2>
              <p class="small">{related.name} — {related.price}.</p>
              <a class="text-link" href={`/services#${related.id}`}>See the service →</a>
            </div>
          )}
        </aside>
      </div>

      {data.prove.length > 0 && (
        <div class="prove">
          <h2>What this proves for your business</h2>
          <ul>
            {data.prove.map((item) => <li>{item}</li>)}
          </ul>
          <a class="btn btn--accent btn--sm" href="/contact">Talk through your version of this <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      )}

      <a class="next-project" href={`/work/${next.id}/`}>
        <span>
          Next project
          <b>{next.data.title}</b>
        </span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </article>

  <CTA />
</BaseLayout>
