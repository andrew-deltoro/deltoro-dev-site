---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHead from '../components/SectionHead.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { site, services, hourly, addons, faqs, process } from '../data/site';

const description =
  'IT and security services for small businesses in the Coachella Valley: security audits from $750, email and account hardening from $900, backup and network work, automation, websites, and a $350/month care plan.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'IT and security consulting',
    provider: { '@type': 'ProfessionalService', name: site.name, url: site.url },
    areaServed: 'Coachella Valley and remote within California and the United States',
    description,
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'Consulting services',
      itemListElement: services.map((s) => ({
        '@type': 'Offer',
        name: s.name,
        description: s.summary,
        priceCurrency: 'USD',
        priceSpecification: {
          '@type': 'PriceSpecification',
          price: s.price.replace(/[^0-9.]/g, '') || undefined,
          priceCurrency: 'USD',
          description: s.priceNote,
        },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={`Services & pricing — ${site.name}`} description={description} jsonLd={jsonLd}>
  <section class="page-hero">
    <div class="wrap">
      <p class="eyebrow">Services & pricing</p>
      <h1>Clear scope. Fixed price. No retainer trap.</h1>
      <p class="lead">
        You should know what the work costs before it starts. Every engagement begins with a free call and a written,
        fixed-fee quote. The numbers below are honest starting points — if your situation is smaller, the quote will be too.
      </p>
      <div class="hero-actions">
        <a class="btn btn--accent" href="/contact">Get a quote <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="#pricing">How pricing works</a>
      </div>
    </div>
  </section>

  <section class="section" id="offerings" style="padding-top:0;border-top:0">
    <div class="wrap">
      <h2 class="visually-hidden">All services</h2>
      <nav class="anchor-nav" aria-label="Services">
        {services.map((s) => <a href={`#${s.id}`}>{s.name.replace(' & Hardening Plan', '').replace(' Setup', '')}</a>)}
      </nav>

      {services.map((service, index) => (
        <article class="service-detail" id={service.id}>
          <div>
            <p class="label">
              <span>{String(index + 1).padStart(2, '0')} / Service</span>
              <span class="price">{service.price}</span>
            </p>
            <h2>{service.name}</h2>
            <p class="kicker">{service.kicker}</p>
            <p class="desc">{service.summary}</p>
            <dl class="meta">
              <div><dt>Best for</dt><dd>{service.bestFor}</dd></div>
              <div><dt>Timeline</dt><dd>{service.timeline}</dd></div>
              <div><dt>Price</dt><dd>{service.price} · {service.priceNote}</dd></div>
            </dl>
            <p style="margin-top:1.4rem">
              <a class="text-link" href={`/contact?service=${encodeURIComponent(service.name)}`}>Ask about this service <span aria-hidden="true">→</span></a>
            </p>
          </div>

          <div class="includes">
            <h3>What's included</h3>
            <ul>
              {service.includes.map((item) => <li>{item}</li>)}
            </ul>
            <p class="deliverable"><b>You end up with</b>{service.deliverable}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section" id="pricing">
    <div class="wrap">
      <SectionHead
        num="Pricing"
        title="How the money works"
        intro="No hourly surprises, no minimum monthly spend you cannot cancel, and no invoice for a conversation."
      />
      <div class="grid-3 reveal">
        <div class="pillar">
          <span class="num">01 / THE CALL</span>
          <h3>Free, and useful.</h3>
          <p>
            Twenty minutes to understand the problem. You leave with a straight answer about what I would look at first,
            whether or not you hire me.
          </p>
        </div>
        <div class="pillar">
          <span class="num">02 / THE QUOTE</span>
          <h3>Fixed, in writing.</h3>
          <p>
            A scope document with the work, the price, and what is explicitly excluded. You approve it before anything changes.
            If the scope changes, so does the quote — in writing.
          </p>
        </div>
        <div class="pillar">
          <span class="num">03 / THE INVOICE</span>
          <h3>Half up front, half on delivery.</h3>
          <p>
            50% to schedule the work, the balance when you have the deliverable and the handover. Care plans bill monthly,
            cancel with 30 days' notice.
          </p>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.1rem;margin-top:1.6rem" class="price-pair">
        <div class="price-block">
          <div class="head">
            <h3>Hourly work</h3>
            <span class="amount">{hourly.standard} standard</span>
          </div>
          <div class="addon-row">
            <b>Small jobs & follow-ups</b>
            <span>{hourly.standard}</span>
            <p>For work too small to justify a fixed-fee scoping exercise.</p>
          </div>
          <div class="addon-row">
            <b>Urgent / after-hours</b>
            <span>{hourly.urgent}</span>
            <p>Active incidents, evenings, and weekends. Two-hour minimum for incident response.</p>
          </div>
          <div class="addon-row">
            <p>{hourly.note}</p>
          </div>
        </div>

        <div class="price-block">
          <div class="head">
            <h3>Add-ons</h3>
            <span class="amount">quoted with the project</span>
          </div>
          {addons.map((addon) => (
            <div class="addon-row">
              <b>{addon.name}</b>
              <span>{addon.price}</span>
              <p>{addon.note}</p>
            </div>
          ))}
        </div>
      </div>

      <p class="small" style="margin-top:1.2rem">
        Prices are in USD and exclude applicable taxes and third-party licensing (backup software, hardware, domain fees),
        which are passed through at cost with your approval. No affiliate markup.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        num="Process"
        title="What actually happens"
        intro="The same four steps for a $750 checkup or a $10,000 build. The only difference is how long each one takes."
      />
      <div class="steps">
        {process.map((step) => (
          <div class="step">
            <span class="n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
      <div class="note" style="margin-top:1.6rem">
        <div>
          <p><b>Working with an existing IT team?</b><br />I'll work hand in hand with your IT team to implement these suggestions.</p>
          <p style="margin:0.7rem 0 0"><b>No IT team? No worries.</b><br />Think of me as your temporary IT team to perform the improvements you're looking for.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <SectionHead num="FAQ" title="The questions worth asking" intro="If yours is not here, email me. I answer every one." />
      <div style="max-width:900px">
        <FAQ items={faqs} />
      </div>
    </div>
  </section>

  <CTA
    title="Tell me what is broken."
    body="Twenty minutes, no deck. I'll tell you what I would fix first and what it would cost — and if I'm not the right person, I'll say so."
  />
</BaseLayout>

<style>
  @media (max-width: 820px) {
    .price-pair {
      grid-template-columns: 1fr !important;
    }
  }
</style>