---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHead from '../components/SectionHead.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import { site, process, faqs, stats } from '../data/site';

const projects = await getCollection('projects');
const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);

const homeFaqs = faqs.slice(0, 5);

const priceHighlights = [
  { name: 'Website setup', price: '$200', note: 'Three pages, built and handed over.', href: '/services#web-tools' },
  { name: 'Other IT & security work', price: 'Quoted', note: 'Scope and fixed price after a call.', href: '/contact' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#business`,
    name: `${site.name} — IT & Security Consulting`,
    url: site.url,
    image: `${site.url}/og/default.png`,
    description: site.description,
    email: `mailto:${site.email}`,
    priceRange: '$$',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Coachella Valley',
      addressRegion: 'CA',
      addressCountry: 'US',
    },
    areaServed: [
      { '@type': 'City', name: 'Palm Springs' }, { '@type': 'City', name: 'Palm Desert' }, { '@type': 'City', name: 'Rancho Mirage' },
      { '@type': 'City', name: 'Cathedral City' }, { '@type': 'City', name: 'Indian Wells' }, { '@type': 'City', name: 'La Quinta' }, { '@type': 'City', name: 'Indio' }, { '@type': 'City', name: 'Coachella' }, { '@type': 'City', name: 'Desert Hot Springs' }, { '@type': 'AdministrativeArea', name: 'Coachella Valley' },
      { '@type': 'Country', name: 'United States (remote)' },
    ],
    founder: {
      '@type': 'Person',
      name: site.name,
      jobTitle: site.role,
      sameAs: [site.linkedin, site.github, site.credly],
    },
    sameAs: [site.linkedin, site.github, site.credly],
    knowsAbout: [
      'IT security', 'Security audits', 'Microsoft 365 administration', 'Google Workspace',
      'Backup and disaster recovery', 'Network segmentation', 'SIEM', 'Detection engineering',
      'Workflow automation', 'AI integration', 'Web development',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.title,
    publisher: { '@id': `${site.url}/#business` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: homeFaqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={`${site.name} — IT & Security Consulting in the Coachella Valley`}
  description={site.description}
  jsonLd={jsonLd}
>
  <section class="hero">
    <div class="wrap hero-inner">
      <div>
        <p class="eyebrow">IT & security consulting · Coachella Valley</p>
        <h1>Your <span class="mark">IT</span> team.</h1>
        <p class="lead">
          I help small businesses fix the IT problems that keep getting postponed: exposed accounts,
          untested backups, a website AI search engines cannot read, and work a person is still doing by hand.
          <strong>Security+ certified. Fixed-fee quotes. No long contracts.</strong>
        </p>
        <div class="hero-actions">
          <a class="btn btn--accent" href="/contact">Book a free 20-minute call <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/work">See the work</a>
        </div>
        <p class="hero-note">
          <span>No pitch deck</span>
          <span>Straight answers</span>
          <span>You own everything</span>
        </p>
      </div>

      <div class="hero-panel">
        <a class="shot-frame" href="/work/pysiem/" aria-label="PySIEM · detection console · live demo — read the case study">
          <img
            src="/images/projects/pysiem-1440.webp"
            srcset="/images/projects/pysiem-720.webp 720w, /images/projects/pysiem-1440.webp 1440w"
            sizes="(max-width: 960px) 100vw, 46vw"
            width="1440"
            height="900"
            alt="PySIEM detection console showing alerts by severity, rule name, host, and MITRE-mapped event IDs"
            fetchpriority="high"
          />
          <div class="shot-bar">
            <span><b>PySIEM</b> · detection console</span>
            <span class="live">Live demo</span>
          </div>
        </a>
        <a class="badge-float" href={site.credly} target="_blank" rel="noopener">
          <img src="/images/credly-security-plus.png" alt="" width="44" height="44" />
          <span>Verified<b>Security+ CE</b></span>
        </a>
        <p class="shot-caption">
          A SIEM and EDR I built from scratch and run in a three-VM home lab.
          Real detections, sanitized for the public demo.
        </p>
      </div>
    </div>
  </section>

  <div class="trust">
    <div class="wrap trust-inner">
      {stats.map((s) => (
        <div class="trust-item">
          <b>{s.value}</b>
          <span>{s.label}</span>
        </div>
      ))}
    </div>
  </div>

  <section class="section" id="services">
    <div class="wrap">
      <SectionHead
        num="01"
        title="Where I'm useful"
        intro="One thing is priced in public. Everything else — security, backups, email, automation — I quote after we talk, because it depends entirely on what you already own."
      />

      <div class="grid-3 reveal">
        <div class="pillar">
          <span class="num">A / EXPOSURE</span>
          <h3>You do not know what is exposed.</h3>
          <p>
            MFA switched off, a former employee still in the tenant, DMARC set to monitor and forgotten.
            I find the gaps and tell you which ones matter this week.
          </p>
          <a href="/services#security-audit">Security checkup <span aria-hidden="true">→</span></a>
        </div>
        <div class="pillar">
          <span class="num">B / RESILIENCE</span>
          <h3>It works until it does not.</h3>
          <p>
            Backups that have never been restored, a flat network where the guest Wi-Fi can see the POS,
            and one person who knows how it all fits together.
          </p>
          <a href="/services#backup-recovery">Backups & network <span aria-hidden="true">→</span></a>
        </div>
        <div class="pillar">
          <span class="num">C / LEVERAGE</span>
          <h3>Too much is still manual.</h3>
          <p>
            Intake forms retyped into spreadsheets, reports assembled by hand, an inbox doing the work of
            a system. I build the small tool that removes the step.
          </p>
          <a href="/services#automation-ai">Automation & AI <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="work">
    <div class="wrap">
      <SectionHead
        num="02"
        title="Selected work"
        intro="Twelve projects built this year. Each one has a case study, the thinking behind it, and a live demo where the demo is public."
      />

      <div class="work-grid">
        {featured.map((project, i) => <ProjectCard project={project} eager={i < 2} />)}
      </div>

      <div style="margin-top:2rem;display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between">
        <p class="small" style="margin:0;max-width:52ch">
          Including a self-hosted AI agent, a pairs-trading experiment on Hyperliquid that I archived, and a school bus route bidding platform.
        </p>
        <a class="btn btn--ghost btn--sm" href="/work">All twelve projects <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        num="03"
        title="How an engagement runs"
        intro="Four steps, a fixed quote, and no work starts until you have approved the scope in writing."
      />
      <div class="steps">
        {process.map((step) => (
          <div class="step">
            <span class="n">{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark quotes-section">
    <div class="wrap">
      <div class="quotes-head">
        <p class="eyebrow">04 / Working with your team</p>
        <h2>I do not need to own your IT.</h2>
        <p>
          I need to fix the specific thing that is broken, then leave your people better equipped to keep it that way.
          How that looks depends on who is already in the room.
        </p>
      </div>

      <div class="quote-list">
        <div class="quote-row">
          <div class="who"><b>If you have IT</b>In-house team or MSP</div>
          <blockquote>I'll work hand in hand with your IT team to implement these suggestions.</blockquote>
        </div>
        <div class="quote-row">
          <div class="who"><b>If you don't</b>Solo owner or small office</div>
          <blockquote>No IT team? No worries.</blockquote>
        </div>
        <div class="quote-row">
          <div class="who"><b>Either way</b>The whole offer</div>
          <blockquote>Think of me as your IT team to perform the improvements you're looking for.</blockquote>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap cred-grid">
      <div class="cred-badge reveal">
        <img src="/images/credly-security-plus.png" alt="CompTIA Security+ Certified badge" width="200" height="200" loading="lazy" />
        <span class="caption">CompTIA Security+ CE · SY0-701</span>
      </div>
      <div class="cred-copy">
        <p class="eyebrow">05 / Who you're hiring</p>
        <h2>Certified, and I build the tools I recommend.</h2>
        <p>
          I'm <strong>Andrew Del Toro</strong>. I passed the CompTIA Security+ exam this year, and I spent the rest of it
          building the things on this site: a SIEM, a Python curriculum for security analysts, an automated signal
          pipeline, a self-hosted AI agent, and a few websites for local businesses.
        </p>
        <p>
          That matters for one reason: I have actually configured the controls, broken the backups, and fixed the
          detections. You are not hiring a slide deck.
        </p>
        <ul class="cred-list">
          <li>Security+ CE</li>
          <li>Wazuh home lab</li>
          <li>Detection engineering</li>
          <li>Microsoft 365</li>
          <li>Python & automation</li>
          <li>Linux VPS</li>
        </ul>
        <a class="text-link" href="/about">More about how I work <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead
        num="06"
        title="What it costs"
        intro="One public price. A complete website setup is $200 flat, handed over to you. Other work is quoted after a short call."
      />
      <div class="grid-3 reveal">
        {priceHighlights.map((item) => (
          <a class="pillar" href={item.href} style="text-decoration:none;display:block">
            <span class="num">{item.price}</span>
            <h3>{item.name}</h3>
            <p>{item.note}</p>
            <span class="mono" style="display:inline-block;margin-top:1.2rem;color:var(--accent-ink)">See what's included →</span>
          </a>
        ))}
      </div>
      <p class="small" style="margin-top:1.4rem">
        The $200 covers the three-page setup. Domain and hosting stay in your name and are paid directly to the provider.
        <a class="text-link" href="/services">See what is included</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead num="07" title="Questions worth asking" intro="The ones I get most often, answered without a sales voice." />
      <div style="max-width:900px">
        <FAQ items={homeFaqs} />
        <p class="small" style="margin-top:1.4rem">
          More questions — including what happens to your data — are on the <a class="text-link" href="/services#faq">services page</a>.
        </p>
      </div>
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .doors-section {
    border-bottom: 1px solid var(--line);
  }
  .doors {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--line);
    border-left: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .door {
    display: block;
    background: var(--surface);
    padding: 26px 30px 24px;
    text-decoration: none;
    color: inherit;
    transition: background 0.15s ease;
  }
  .door:hover,
  .door:focus-visible {
    background: var(--surface-2);
  }
  .door-k {
    display: block;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin: 0 0 9px;
  }
  .door h2 {
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  .door p {
    margin: 0 0 14px;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.5;
    max-width: 48ch;
  }
  .door-link {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }
  @media (max-width: 760px) {
    .doors {
      grid-template-columns: 1fr;
    }
    .door {
      padding: 22px var(--gutter);
    }
  }
</style>